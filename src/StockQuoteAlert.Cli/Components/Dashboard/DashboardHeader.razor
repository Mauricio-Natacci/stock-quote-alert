<header class="header">
    <div class="header__brand">
        <span class="header__logo" aria-hidden="true">◆</span>
        <div>
            <h1 class="header__title">Stock Quote Alert</h1>
            <p class="header__subtitle">Monitoramento de cotações B3 com alertas por e-mail</p>
        </div>
    </div>

    <div class="header__meta">
        @if (Tickers.Count == 1)
        {
            <span class="ticker-badge">@Tickers[0]</span>
        }
        else
        {
            <span class="ticker-badge" title="@string.Join(", ", Tickers)">@DashboardText.Assets(Tickers.Count)</span>
        }
        <span class="header__detail">Fonte: @Provider · atualiza a cada @DashboardText.Interval(PollingInterval)</span>
        <span class="connection connection--@DashboardText.ConnectionModifier(Health)" role="status">
            <span class="connection__dot" aria-hidden="true"></span>
            @DashboardText.ConnectionState(Health)
        </span>
    </div>
</header>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Tickers { get; set; } = [];

    [Parameter, EditorRequired] public string Provider { get; set; } = string.Empty;

    [Parameter, EditorRequired] public TimeSpan PollingInterval { get; set; }

    [Parameter, EditorRequired] public MonitoringHealth Health { get; set; }
}
